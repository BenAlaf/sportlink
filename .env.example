# Copy to `.env` and fill in once your Supabase project exists.
# Expo inlines EXPO_PUBLIC_* vars at build time. Restart `expo start` after editing.
#
# Without these, the app runs on its on-device fallbacks (rule-based coach + mock data).
# With them, the AI Coach chat upgrades to the OpenAI-backed Edge Function.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — set these as Supabase Edge Function secrets, NOT here:
#   supabase secrets set OPENAI_API_KEY=sk-...
#   (GraphHopper key lands the same way in M3)
